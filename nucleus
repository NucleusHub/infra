#!/bin/sh
# Nucleus — manifest-driven orchestration wrapper
# Usage: ./nucleus [docker compose args]
#   ./nucleus up -d
#   ./nucleus down
#   ./nucleus logs -f hub
set -e
cd "$(dirname "$0")"

# Detect AVX — MongoDB 5+ requires it; fall back to 4.4 on older CPUs
if grep -q ' avx ' /proc/cpuinfo 2>/dev/null; then
  MONGO_IMAGE="mongo:7"
else
  MONGO_IMAGE="mongo:4.4"
  echo "[nucleus] No AVX detected — using mongo:4.4"
fi
export MONGO_IMAGE

# Persist to .env so plain 'docker compose up' also gets the right image
if [ -f .env ] && grep -q '^MONGO_IMAGE=' .env; then
  sed -i "s|^MONGO_IMAGE=.*|MONGO_IMAGE=$MONGO_IMAGE|" .env
else
  echo "MONGO_IMAGE=$MONGO_IMAGE" >> .env
fi

# Regenerate nginx + compose configs via the Go infra tool (compiled on demand).
BIN="$(./ensure-tool)"
"$BIN" generate
docker compose -f docker-compose.yml -f docker-compose.override.yml exec -T nginx nginx -s reload 2>/dev/null || true
docker compose \
  -f docker-compose.yml \
  -f docker-compose.override.yml \
  "$@"
