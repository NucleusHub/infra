#!/bin/sh
# Nucleus — manifest-driven orchestration wrapper
# Usage: ./nucleus [--all] [docker compose args]
#   ./nucleus up -d          # bring up app services only
#   ./nucleus down           # tear down app services only
#   ./nucleus --all up -d    # include backing services (mongo, minio, redis)
#   ./nucleus logs -f hub    # an explicitly named service is respected as-is
#
# By default commands are scoped to *app* services: the stateful backing
# services (mongo, minio, redis) are never implicitly recreated or removed, so
# you can bounce apps without dropping the database / cache / object store.
# Pass --all to operate on the whole stack, or name a service explicitly to
# target it (including a backing one, e.g. `./nucleus restart mongo`).
set -e
cd "$(dirname "$0")"

# Backing services excluded from the default (app-only) scope.
DATA_SERVICES="mongo minio redis"

# Pull --all out of the argument list, wherever it appears, while preserving the
# quoting of every other arg (rotate kept args to the end exactly $# times).
ALL=0
n=$#
while [ "$n" -gt 0 ]; do
  arg="$1"; shift
  if [ "$arg" = "--all" ]; then
    ALL=1
  else
    set -- "$@" "$arg"
  fi
  n=$((n - 1))
done

# Detect AVX — MongoDB 5+ requires it; fall back to 4.4 on older CPUs
if grep -q ' avx ' /proc/cpuinfo 2>/dev/null; then
  MONGO_IMAGE="mongo:7"
else
  MONGO_IMAGE="mongo:4.4"
  echo "[nucleus] No AVX detected — using mongo:4.4"
fi
export MONGO_IMAGE

# Persist to .env so plain 'docker compose up' also gets the right image
if [ -f .env ] && grep -q '^MONGO_IMAGE=' .env; then
  sed -i "s|^MONGO_IMAGE=.*|MONGO_IMAGE=$MONGO_IMAGE|" .env
else
  echo "MONGO_IMAGE=$MONGO_IMAGE" >> .env
fi

# Regenerate nginx + compose configs via the Go infra tool (compiled on demand).
BIN="$(./ensure-tool)"
"$BIN" generate

COMPOSE="docker compose -f docker-compose.yml -f docker-compose.override.yml"

# shellcheck disable=SC2086
$COMPOSE exec -T nginx nginx -s reload 2>/dev/null || true

if [ "$ALL" -eq 1 ]; then
  # shellcheck disable=SC2086
  exec $COMPOSE "$@"
fi

# Scope to app services unless the user named a service explicitly.
all_services=$($COMPOSE config --services 2>/dev/null)

user_named_service=0
for a in "$@"; do
  for s in $all_services; do
    [ "$a" = "$s" ] && { user_named_service=1; break; }
  done
  [ "$user_named_service" -eq 1 ] && break
done

if [ "$user_named_service" -eq 1 ]; then
  # shellcheck disable=SC2086
  exec $COMPOSE "$@"
fi

# Build the app-service list (everything except the backing services) and append
# it so the command only ever touches apps.
apps=""
for s in $all_services; do
  skip=0
  for d in $DATA_SERVICES; do
    [ "$s" = "$d" ] && skip=1
  done
  [ "$skip" -eq 0 ] && apps="$apps $s"
done

# shellcheck disable=SC2086
exec $COMPOSE "$@" $apps
