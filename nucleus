#!/bin/sh
set -e
cd "$(dirname "$0")"

DATA_SERVICES="mongo minio redis"

ALL=0
n=$#
while [ "$n" -gt 0 ]; do
  arg="$1"; shift
  if [ "$arg" = "--all" ]; then
    ALL=1
  else
    set -- "$@" "$arg"
  fi
  n=$((n - 1))
done

if grep -q ' avx ' /proc/cpuinfo 2>/dev/null; then
  MONGO_IMAGE="mongo:7"
else
  MONGO_IMAGE="mongo:4.4"
  echo "[nucleus] No AVX detected — using mongo:4.4"
fi
export MONGO_IMAGE

if [ -f .env ] && grep -q '^MONGO_IMAGE=' .env; then
  awk -v img="$MONGO_IMAGE" '/^MONGO_IMAGE=/ { $0 = "MONGO_IMAGE=" img } 1' .env > .env.tmp && mv .env.tmp .env
else
  echo "MONGO_IMAGE=$MONGO_IMAGE" >> .env
fi

BIN="$(./ensure-tool)"
"$BIN" generate

COMPOSE="docker compose -f docker-compose.yml -f docker-compose.override.yml"

# shellcheck disable=SC2086
$COMPOSE exec -T nginx nginx -s reload 2>/dev/null || true

if [ "$ALL" -eq 1 ]; then
  # shellcheck disable=SC2086
  exec $COMPOSE "$@"
fi

all_services=$($COMPOSE config --services 2>/dev/null)

user_named_service=0
for a in "$@"; do
  for s in $all_services; do
    [ "$a" = "$s" ] && { user_named_service=1; break; }
  done
  [ "$user_named_service" -eq 1 ] && break
done

if [ "$user_named_service" -eq 1 ]; then
  # shellcheck disable=SC2086
  exec $COMPOSE "$@"
fi

apps=""
for s in $all_services; do
  skip=0
  for d in $DATA_SERVICES; do
    [ "$s" = "$d" ] && skip=1
  done
  [ "$skip" -eq 0 ] && apps="$apps $s"
done

# shellcheck disable=SC2086
exec $COMPOSE "$@" $apps
