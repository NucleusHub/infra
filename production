#!/usr/bin/env bash
set -euo pipefail

INFRA="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/lib/bluegreen.sh
source "$INFRA/lib/bluegreen.sh"

START_TIME=$(date +%s)
report_elapsed() {
  local elapsed=$(( $(date +%s) - START_TIME ))
  printf '\n⏱  Total time: %dm %02ds\n' "$((elapsed / 60))" "$((elapsed % 60))"
}
trap report_elapsed EXIT

[ -n "$(read_active)" ] || die "No active color found. Run infra/bluegreen-init first (one-time migration)."

OLD="$(read_active)"
TARGET="$(target_color)"

log_stage "Pulling latest changes..."
"$INFRA/update" || log_warn "Some repos failed to pull — continuing with what is checked out."

ensure_networks
set_mongo_image
ensure_data
ensure_edge

log_info "Active color: ${OLD} → deploying to: ${TARGET}"

log_stage "Building images..."
BIN="$("$INFRA/ensure-tool")"
( cd "$INFRA" && "$BIN" build "$@" )

log_info "Snapshotting frontend build into ${TARGET}…"
snapshot_dist "$TARGET"

log_stage "Starting ${TARGET^}..."
ensure_port_free "$TARGET"
dc_stack "$TARGET" up -d --build --remove-orphans

log_stage "Waiting for health..."
if ! wait_stack_healthy "$TARGET" || ! health_probe "$TARGET"; then
  log_err "The ${TARGET} stack did not become healthy within ${HEALTH_TIMEOUT}s."
  dc_stack "$TARGET" ps || true
  log_err "Traffic NOT switched — ${OLD} is still serving."
  log_err "Inspect the failed color:  cd $INFRA && NUCLEUS_COLOR=$TARGET NUCLEUS_WEB_PORT=$(color_port "$TARGET") docker compose -p nucleus-$TARGET logs"
  log_err "It was left running on http://localhost:$(color_port "$TARGET") for debugging."
  exit 1
fi

log_stage "Switching traffic..."
switch_traffic "$TARGET"
write_active "$TARGET"

log_stage "Stopping ${OLD^}..."
stop_stack "$OLD"

base="https://$(grep -E '^NUCLEUS_HOST=' "$INFRA/.env" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)"
log_ok "Deployment complete. Now serving: ${TARGET}"
[ "$base" != "https://" ] && log_info "→ ${base}/"
log_info "Roll back with: infra/rollback"
