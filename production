#!/usr/bin/env bash
# infra/production — zero-downtime blue/green deployment.
#
# Usage: infra/production [--force] [-j N]     (flags are forwarded to `nucleus build`)
#
# The currently-running color stays online through the git pull, the frontend +
# image builds, and the new color's startup + health checks. The ONLY moment
# traffic is touched is a single graceful edge reload once the new color is
# confirmed healthy. If the new color never goes healthy, the old one keeps
# serving and the failed color is left up for debugging.
#
# Topology (see infra/lib/bluegreen.sh):
#   nucleus-data   always-on  mongo/redis/minio
#   nucleus-blue   ┐ one serves traffic, the other is the deploy target;
#   nucleus-green  ┘ they alternate every deploy
#   nucleus-edge   always-on  nginx :80/:443 → active color
#
# First-time setup (migrating off the old single-project stack) is a separate,
# one-time script: infra/bluegreen-init.
set -euo pipefail

INFRA="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/lib/bluegreen.sh
source "$INFRA/lib/bluegreen.sh"

# Wall-clock timer for the whole run — reported on any exit (success/fail/Ctrl-C).
START_TIME=$(date +%s)
report_elapsed() {
  local elapsed=$(( $(date +%s) - START_TIME ))
  printf '\n⏱  Total time: %dm %02ds\n' "$((elapsed / 60))" "$((elapsed % 60))"
}
trap report_elapsed EXIT

[ -n "$(read_active)" ] || die "No active color found. Run infra/bluegreen-init first (one-time migration)."

OLD="$(read_active)"
TARGET="$(target_color)"

# ── 1. Pull ───────────────────────────────────────────────────────────────────
log_stage "Pulling latest changes..."
"$INFRA/update" || log_warn "Some repos failed to pull — continuing with what is checked out."

# ── 2. Bootstrap the always-on layers (idempotent) ────────────────────────────
ensure_networks
set_mongo_image
ensure_data
ensure_edge

log_info "Active color: ${OLD} → deploying to: ${TARGET}"

# ── 3. Build frontends + regenerate configs (does NOT touch Docker) ───────────
log_stage "Building images..."
BIN="$("$INFRA/ensure-tool")"
( cd "$INFRA" && "$BIN" build "$@" )

# ── 4. Snapshot the fresh dist into the target color (leaves the live color's) ─
log_info "Snapshotting frontend build into ${TARGET}…"
snapshot_dist "$TARGET"

# ── 5. Start the target color alongside the live one (own project + debug port) ─
log_stage "Starting ${TARGET^}..."
# Clear a leaked docker-proxy off this color's debug port first — otherwise `up`
# dies with "address already in use" and takes the whole deploy with it.
ensure_port_free "$TARGET"
dc_stack "$TARGET" up -d --build --remove-orphans

# ── 6. Wait until the whole target color is healthy ───────────────────────────
log_stage "Waiting for health..."
if ! wait_stack_healthy "$TARGET" || ! health_probe "$TARGET"; then
  log_err "The ${TARGET} stack did not become healthy within ${HEALTH_TIMEOUT}s."
  dc_stack "$TARGET" ps || true
  log_err "Traffic NOT switched — ${OLD} is still serving."
  log_err "Inspect the failed color:  cd $INFRA && NUCLEUS_COLOR=$TARGET NUCLEUS_WEB_PORT=$(color_port "$TARGET") docker compose -p nucleus-$TARGET logs"
  log_err "It was left running on http://localhost:$(color_port "$TARGET") for debugging."
  exit 1
fi

# ── 7. Switch traffic (single graceful edge reload) ───────────────────────────
log_stage "Switching traffic..."
switch_traffic "$TARGET"
write_active "$TARGET"

# ── 8. Stop the old color (kept intact for one-command rollback) ──────────────
log_stage "Stopping ${OLD^}..."
stop_stack "$OLD"

# ── 9. Done ───────────────────────────────────────────────────────────────────
base="https://$(grep -E '^NUCLEUS_HOST=' "$INFRA/.env" 2>/dev/null | cut -d= -f2 | tr -d '"' || true)"
log_ok "Deployment complete. Now serving: ${TARGET}"
[ "$base" != "https://" ] && log_info "→ ${base}/"
log_info "Roll back with: infra/rollback"
