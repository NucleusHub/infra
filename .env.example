MONGODB_URI=mongodb://localhost:27017/nucleus
PORT=3000
# Get a free API key at https://www.themoviedb.org/settings/api
VITE_TMDB_API_KEY=
# Spotify — create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://nucleus.home/api/spotify/callback
SPOTIFY_SUCCESS_REDIRECT=http://nucleus.home/spotify
# MinIO — object storage for Orbit
MINIO_ACCESS_KEY=nucleusadmin
MINIO_SECRET_KEY=nucleuschangeme
MINIO_PUBLIC_URL=http://localhost
MINIO_BUCKET=orbit-uploads
# Public hostname for prod (nginx server_name + the link shown after a build)
NUCLEUS_HOST=nucleus.olm-altair.ts.net
# Outgoing mail (./mail): a Postfix relay in the data stack sends through Resend.
# MAIL_FROM must be on a domain verified in Resend; the relay is only started once the key is set.
RESEND_API_KEY=
MAIL_FROM=Nucleus <alerts@nucleus-home.dev>
MAIL_TO=
