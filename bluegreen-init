#!/usr/bin/env bash
set -euo pipefail

INFRA="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=infra/lib/bluegreen.sh
source "$INFRA/lib/bluegreen.sh"

if [ -n "$(read_active)" ]; then
  die "Already initialized (active color: $(read_active)). Use infra/production to deploy."
fi

log_stage "Blue/green one-time migration"
log_warn "This performs a single brief downtime while data + proxy move to the new layout."

ensure_networks
set_mongo_image

log_stage "Building images..."
BIN="$("$INFRA/ensure-tool")"
( cd "$INFRA" && "$BIN" build )

log_info "Snapshotting frontend build into blue…"
snapshot_dist blue

log_info "Pre-building the blue color images…"
dc_stack blue build

legacy="$(docker ps -aq --filter 'label=com.docker.compose.project=nucleus' 2>/dev/null || true)"
if [ -n "$legacy" ]; then
  log_stage "Stopping legacy monolithic stack (brief downtime begins)…"
  # shellcheck disable=SC2086
  docker rm -f $legacy >/dev/null
else
  log_info "No legacy 'nucleus' project found — treating this as a fresh install."
fi

log_stage "Starting shared data stack…"
ensure_data

log_stage "Starting Blue..."
dc_stack blue up -d --remove-orphans

log_stage "Waiting for health..."
if ! wait_stack_healthy blue || ! health_probe blue; then
  log_err "Blue did not become healthy. The edge is not up yet, so nothing is serving."
  log_err "Inspect:  cd $INFRA && NUCLEUS_COLOR=blue NUCLEUS_WEB_PORT=$(color_port blue) docker compose -p nucleus-blue logs"
  exit 1
fi

log_stage "Starting edge proxy (binds :80/:443)…"
ensure_edge

log_stage "Switching traffic..."
switch_traffic blue
write_active blue

log_ok "Migration complete. Now serving: blue"
log_info "Next deploy will build & switch to green automatically:  infra/production"
