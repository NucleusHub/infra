#!/bin/sh
set -e

INFRA="$(cd "$(dirname "$0")" && pwd)"
REPO="$(dirname "$INFRA")"
TOOL_DIR="$INFRA/tool"
BIN="$TOOL_DIR/nucleus"
CACHE_DIR="$INFRA/.build-cache"
mkdir -p "$CACHE_DIR"
HASH_FILE="$CACHE_DIR/tool.hash"

case "$(uname -s)" in
  Darwin) GOOS=darwin ;;
  Linux) GOOS=linux ;;
  *) GOOS=linux ;;
esac
case "$(uname -m)" in
  arm64|aarch64) GOARCH=arm64 ;;
  *) GOARCH=amd64 ;;
esac

tool_hash="$(
  { for f in "$TOOL_DIR"/*.go; do case "$f" in (*_test.go) ;; (*) cat "$f" ;; esac; done
    cat "$TOOL_DIR/go.mod" "$TOOL_DIR"/*.html
    find "$TOOL_DIR/ui" -type f 2>/dev/null | LC_ALL=C sort | xargs cat 2>/dev/null
    printf '%s %s' "$GOOS" "$GOARCH"
  } 2>/dev/null | sha1sum | cut -d' ' -f1
)"

if [ ! -x "$BIN" ] || [ "$(cat "$HASH_FILE" 2>/dev/null)" != "$tool_hash" ]; then
  echo "▶ Compiling nucleus infra tool (golang:1.23-alpine)…" >&2
  docker run --rm -v "$REPO":/src -w /src/infra/tool \
    -e CGO_ENABLED=0 -e GOOS="$GOOS" -e GOARCH="$GOARCH" \
    golang:1.23-alpine \
    go build -trimpath -ldflags "-s -w" -o nucleus . >&2
  echo "$tool_hash" > "$HASH_FILE"
fi

printf '%s\n' "$BIN"
