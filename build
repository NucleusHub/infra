#!/usr/bin/env bash
# Builds all Vue frontends for production and starts the stack via Docker Compose.
#
# This is a thin shim around the `nucleus` infra tool (infra/tool, written in Go).
# It compiles the tool on demand (in a golang:1.23-alpine container — no host Go
# needed) and hands off to `nucleus build`, which does the real work:
#
#   • incremental, parallel frontend builds (hub, every app client, widgets) with
#     a content-fingerprint cache under infra/.build-cache; npm/pnpm install is
#     skipped unless the lockfile changed
#   • regenerates nginx + docker-compose configs from the app/widget manifests
#   • brings the production stack up with `docker compose ... up -d --build`
#
# Flags: --force / -f  rebuild every unit;  -j N  max parallel build units.
# Run from any directory — paths are resolved relative to this script.
set -euo pipefail

INFRA="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

BIN="$("$INFRA/ensure-tool")"

cd "$INFRA"
exec "$BIN" build "$@"
