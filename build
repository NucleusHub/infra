#!/usr/bin/env bash
# Builds all Vue frontends for production and starts the stack via Docker Compose.
# vueDevTools() is excluded automatically (mode=production); Vite never bundles HMR.
# Run from any directory — paths are resolved relative to this script.
set -euo pipefail

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# ── Colour helpers ────────────────────────────────────────────────────────────
bold="\033[1m"; green="\033[32m"; yellow="\033[33m"; reset="\033[0m"
step() { echo -e "\n${bold}${green}▶ $*${reset}"; }
warn() { echo -e "${yellow}⚠  $*${reset}"; }

# ── Load .env (provides VITE_* vars baked into frontend builds) ───────────────
if [[ -f "$REPO/infra/.env" ]]; then
  set -a
  # shellcheck disable=SC1091
  source "$REPO/infra/.env"
  set +a
fi

# ── npm install helper — prefers ci (clean/reproducible), falls back to install ──
npm_install() { npm ci --prefer-offline 2>/dev/null || npm install; }

# ── 1. Build Vue frontends ────────────────────────────────────────────────────

step "Building hub"
ln -sfn "$REPO/core" "$REPO/hub/core"
# Widgets are discovered by the hub build via import.meta.glob('../../widgets/*/Widget.vue')
ln -sfn "$REPO/widgets" "$REPO/hub/widgets"
# Auto-symlink hub library apps (client/ dir with no vite.config.js = not a standalone app)
for app_dir in "$REPO/apps"/*/; do
  app_id="$(basename "$app_dir")"
  client_dir="$app_dir/client"
  [[ -d "$client_dir" && ! -f "$client_dir/vite.config.js" ]] && ln -sfn "$client_dir" "$REPO/hub/$app_id"
done
cd "$REPO/hub"
npm_install
npm run build

# Auto-discover every app client (apps/*/client with a vite.config.js)
while IFS= read -r -d '' cfg; do
  client_dir="$(dirname "$cfg")"
  app_name="$(basename "$(dirname "$client_dir")")"
  step "Building $app_name client"
  ln -sfn "$REPO/core" "$client_dir/core"
  cd "$client_dir"
  npm_install
  npm run build
done < <(find "$REPO/apps" -maxdepth 3 -name "vite.config.js" -path "*/client/*" -print0 | sort -z)

step "Building widgets"
cd "$REPO/widgets"
pnpm install --frozen-lockfile
pnpm run build

# ── 2. Generate nginx and compose configs from manifests ─────────────────────

step "Generating infra configs"
cd "$REPO/infra"
node generate.js

# ── 3. Deploy ─────────────────────────────────────────────────────────────────

if grep -q ' avx ' /proc/cpuinfo 2>/dev/null; then
  export MONGO_IMAGE=mongo:7
  warn "AVX detected — using mongo:7"
else
  export MONGO_IMAGE=mongo:4.4
  warn "No AVX — falling back to mongo:4.4"
fi

step "Starting production stack"
cd "$REPO/infra"
docker compose -f docker-compose.prod.yml up -d --build --remove-orphans

echo -e "\n${bold}${green}✓ Production stack is up.${reset}"
echo "  Hub       → http://nucleus.home/"
echo "  Watchlist → http://nucleus.home/watchlist/"
echo "  Goals     → http://nucleus.home/goals/"
echo "  Orbit     → http://nucleus.home/orbit/"
echo "  Spotify   → http://nucleus.home/spotify/"
